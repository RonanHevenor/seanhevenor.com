---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Masthead from '../components/Masthead.astro';
import portrait from '../assets/portrait.jpg';
import { Content, frontmatter } from '../copy/home.md';
import { SITE } from '../site.config';
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <Hero />
  <div class="over">
    <div class="container profile">
      <aside class="side">
        <Image src={portrait} alt={SITE.title} width={300} height={400} densities={[1, 2]} />
        <Masthead />
      </aside>
      <section class="bio">
        <Content />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .over {
    background: var(--bg);
  }
  .profile {
    display: grid;
    grid-template-columns: 18rem minmax(0, 40rem);
    justify-content: center;
    column-gap: clamp(2.5rem, 6vw, 5rem);
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .side {
    position: sticky;
    top: 3rem;
    align-self: start;
  }
  .side :global(img) {
    width: 100%;
    height: auto;
    margin-bottom: 1.5rem;
  }
  .bio {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.8;
  }
  .bio :global(p) {
    margin: 0 0 1.5rem;
  }
  .bio :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 48rem) {
    .profile {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2.5rem;
    }
    .side {
      position: static;
      display: grid;
      grid-template-columns: 7.5rem 1fr;
      column-gap: 1.25rem;
      align-items: center;
    }
    .side :global(img) {
      margin: 0;
    }
  }
</style>
