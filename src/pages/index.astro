---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Tile from '../components/Tile.astro';
import Closing from '../components/Closing.astro';
import harbor from '../assets/harbor.jpg';
import portrait from '../assets/portrait.jpg';
import { frontmatter, rawContent } from '../copy/home.md';
import { SITE } from '../site.config';

// home.md holds four paragraphs, in order:
// the person (with portrait), the place (with harbor), a statement, the close.
const [person, place, statement, close] = rawContent().trim().split(/\n\s*\n/);
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <Masthead />

  <Tile image={portrait} alt={SITE.title} side="left" ratio="4 / 5" position="50% 20%" eager reveal={false} small>
    <p>{person}</p>
  </Tile>

  <Tile image={harbor} side="right" ratio="4 / 3">
    <p>{place}</p>
  </Tile>

  <section class="container statement reveal">
    <p>{statement}</p>
  </section>

  <Closing>
    <p>{close}</p>
  </Closing>
</BaseLayout>

<style>
  .statement {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .statement p {
    max-width: 40rem;
  }
</style>
