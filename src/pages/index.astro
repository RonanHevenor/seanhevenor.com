---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Tile from '../components/Tile.astro';
import Closing from '../components/Closing.astro';
import harbor from '../assets/harbor.jpg';
import portrait from '../assets/portrait.jpg';
import { frontmatter, rawContent } from '../copy/home.md';
import { SITE } from '../site.config';

// home.md holds four paragraphs. Each gets its own screen, in order:
// statement, the place, the person, the close.
const [statement, place, person, close] = rawContent().trim().split(/\n\s*\n/);
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <Header />
  <Hero />

  <section class="statement">
    <div class="container reveal">
      <p>{statement}</p>
    </div>
  </section>

  <Tile image={harbor} side="left" ratio="5 / 4">
    <p>{place}</p>
  </Tile>

  <Tile image={portrait} alt={SITE.title} side="right" ratio="1 / 1" position="50% 30%">
    <p>{person}</p>
  </Tile>

  <Closing>
    <p>{close}</p>
  </Closing>
</BaseLayout>

<style>
  .statement {
    padding: var(--section) 0;
  }
  .statement p {
    max-width: 58rem;
    font-size: clamp(1.5rem, 2.7vw, 2.3rem);
    line-height: 1.4;
  }
</style>
