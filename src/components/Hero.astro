---
import { Image } from 'astro:assets';
import hero from '../assets/hero.jpg';
import { SITE } from '../site.config';
---

<section class="hero">
  <Image
    src={hero}
    alt=""
    widths={[768, 1280, 1920, 2560, 3200]}
    sizes="100vw"
    quality={88}
    loading="eager"
    fetchpriority="high"
  />
  <div class="shade" aria-hidden="true"></div>
  <div class="container text">
    <h1>{SITE.title}</h1>
    <p>{SITE.tagline}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: clamp(30rem, 82vh, 60rem);
    overflow: hidden;
    background: var(--navy-deep);
    color: var(--white);
  }
  /* Image is 15% taller than the band; on load it slides up so the view
     tilts from sky down to the harbor. Transform keeps it on the GPU. */
  .hero :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 115%;
    object-fit: cover;
    object-position: 50% 0%;
    will-change: transform;
    transform: translateY(-13.04%);
    animation: tilt 6s cubic-bezier(0.3, 0.5, 0.2, 1) both;
  }
  @keyframes tilt {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-13.04%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero :global(img) {
      animation: none;
    }
  }
  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 24, 42, 0.75) 0%, rgba(10, 24, 42, 0.25) 38%, transparent 62%),
      linear-gradient(to bottom, rgba(10, 24, 42, 0.35) 0%, transparent 22%);
    pointer-events: none;
  }
  .text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: clamp(2.5rem, 7vh, 5rem);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  }
  h1 {
    margin: 0;
    font-weight: 400;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  p {
    margin-top: 0.75rem;
    font-style: italic;
    font-size: clamp(1.15rem, 2.2vw, 1.7rem);
    line-height: 1.3;
  }
</style>
