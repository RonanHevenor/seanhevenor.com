---
import { SITE } from '../site.config';
const year = new Date().getFullYear();
const hasContent = SITE.author || SITE.social.length > 0;
---

{hasContent && (
  <footer>
    <div class="container">
      {SITE.social.length > 0 && (
        <ul>
          {SITE.social.map((s) => (
            <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>
          ))}
        </ul>
      )}
      {SITE.author && <span class="muted">&copy; {year} {SITE.author}</span>}
    </div>
  </footer>
)}

<style>
  footer {
    border-top: 1px solid var(--border);
    box-shadow: 0 -4px 0 -3px var(--border);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }
  div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    text-align: center;
  }
  ul {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }
</style>
