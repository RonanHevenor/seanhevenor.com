---
import { SITE } from '../site.config';
const year = new Date().getFullYear();
---

<footer>
  <div>
    <span class="muted">&copy; {year} {SITE.author}</span>
    <ul>
      {SITE.social.map((s) => (
        <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  div {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  ul {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }
</style>
