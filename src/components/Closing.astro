---
import { SITE } from '../site.config';
const tel = `tel:+1${SITE.phone.replace(/\D/g, '')}`;
const year = new Date().getFullYear();
---

<section class="closing">
  <div class="container grid reveal">
    <div class="text">
      <slot />
      <div class="contact">
        <span class="name">{SITE.author}</span>
        <span class="brokerage">{SITE.brokerage}</span>
        <a class="phone" href={tel}>{SITE.phone}</a>
        <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </div>
  <div class="container grid foot">
    <span class="text">&copy; {year} {SITE.author}</span>
  </div>
</section>

<style>
  .closing {
    padding-top: var(--para);
    padding-bottom: 2rem;
  }
  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: var(--space);
  }
  .name {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
  }
  .brokerage {
    font-style: italic;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    opacity: 0.85;
    margin-bottom: 1.25rem;
  }
  .phone {
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    line-height: 1.1;
  }
  .email {
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    opacity: 0.85;
    margin-top: 0.35rem;
  }
  .foot {
    margin-top: var(--space);
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
