---
import { SITE } from '../site.config';
const tel = `tel:+1${SITE.phone.replace(/\D/g, '')}`;
const year = new Date().getFullYear();
---

<section class="closing">
  <div class="container reveal">
    <slot />
    <div class="contact">
      <span class="name">{SITE.author}</span>
      <span class="brokerage">{SITE.brokerage}</span>
      <a class="phone" href={tel}>{SITE.phone}</a>
      <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
  <footer>
    <div class="container foot">
      <span>&copy; {year} {SITE.author}</span>
    </div>
  </footer>
</section>

<style>
  .closing {
    background: var(--navy);
    color: var(--white);
    padding-top: clamp(3rem, 5.5vw, 4.5rem);
  }
  .closing :global(p) {
    max-width: 40rem;
  }
  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3rem, 5.5vw, 4.5rem);
  }
  .name {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
  }
  .brokerage {
    font-style: italic;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    opacity: 0.85;
    margin-bottom: 1.25rem;
  }
  .phone {
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    line-height: 1.1;
  }
  .email {
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    opacity: 0.85;
  }
  footer {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .foot {
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
  }
</style>
