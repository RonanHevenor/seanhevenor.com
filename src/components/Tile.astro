---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt?: string;
  ratio?: string;
  position?: string;
  eager?: boolean;
  reveal?: boolean;
}

const {
  image,
  alt = '',
  ratio = '4 / 3',
  position = '50% 50%',
  eager = false,
  reveal = true,
} = Astro.props;
---

<section class:list={['container', 'grid', 'tile', { reveal }]}>
  <div class="photo" style={`--ratio: ${ratio}; --pos: ${position};`}>
    <Image
      src={image}
      alt={alt}
      widths={[480, 720, 960, 1440]}
      sizes="(max-width: 48rem) 70vw, 20vw"
      quality={85}
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="text">
    <slot />
  </div>
</section>

<style>
  .tile {
    padding-top: var(--space);
  }
  .photo {
    position: relative;
    aspect-ratio: var(--ratio);
    background: var(--mist);
  }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }
  @media (max-width: 48rem) {
    .photo {
      max-width: 14rem;
    }
  }
</style>
