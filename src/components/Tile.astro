---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt?: string;
  side?: 'left' | 'right';
  ratio?: string;
  position?: string;
  eager?: boolean;
  reveal?: boolean;
  small?: boolean;
}

const {
  image,
  alt = '',
  side = 'left',
  ratio = '4 / 3',
  position = '50% 50%',
  eager = false,
  reveal = true,
  small = false,
} = Astro.props;
---

<section class:list={['container', 'tile', `tile--${side}`, { reveal, 'tile--small': small }]}>
  <div class="photo" style={`--ratio: ${ratio}; --pos: ${position};`}>
    <Image
      src={image}
      alt={alt}
      widths={[480, 720, 960, 1440]}
      sizes="(max-width: 48rem) 100vw, 40vw"
      quality={85}
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="copy">
    <slot />
  </div>
</section>

<style>
  .tile {
    display: grid;
    grid-template-columns: 5fr 7fr;
    column-gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .tile--right {
    grid-template-columns: 7fr 5fr;
  }
  /* A modest photo column, for the headshot */
  .tile--small {
    grid-template-columns: clamp(13rem, 24vw, 20rem) 1fr;
  }
  .tile--right .photo {
    order: 2;
  }
  .photo {
    position: relative;
    aspect-ratio: var(--ratio);
    background: var(--mist);
  }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }
  .copy {
    max-width: 40rem;
  }
  .tile--right .copy {
    justify-self: start;
  }
  @media (max-width: 48rem) {
    .tile,
    .tile--right,
    .tile--small {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
    .tile--right .photo {
      order: 0;
    }
    .tile--small .photo {
      max-width: 16rem;
    }
  }
</style>
