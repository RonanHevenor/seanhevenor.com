---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt?: string;
  side?: 'left' | 'right';
  ratio?: string;
  position?: string;
}

const { image, alt = '', side = 'left', ratio = '5 / 4', position = '50% 50%' } = Astro.props;
---

<section class:list={['tile', `tile--${side}`, 'reveal']}>
  <div class="photo" style={`--ratio: ${ratio}; --pos: ${position};`}>
    <Image src={image} alt={alt} widths={[640, 960, 1280, 1920]} sizes="(max-width: 48rem) 100vw, 50vw" quality={85} />
  </div>
  <div class="copy">
    <div class="copy-inner">
      <slot />
    </div>
  </div>
</section>

<style>
  .tile {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .tile--right .photo {
    order: 2;
  }
  .photo {
    position: relative;
    aspect-ratio: var(--ratio);
    background: var(--mist);
  }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }
  .copy {
    display: flex;
    align-items: center;
    padding: clamp(3rem, 6vw, 6rem) var(--gutter);
  }
  .copy-inner {
    max-width: 34rem;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.6;
  }
  /* Keep the text column's inner edge aligned with the page gutter */
  .tile--left .copy {
    justify-content: flex-start;
    padding-left: clamp(2.5rem, 6vw, 6rem);
  }
  .tile--right .copy {
    justify-content: flex-end;
    padding-right: clamp(2.5rem, 6vw, 6rem);
  }
  @media (max-width: 48rem) {
    .tile {
      grid-template-columns: 1fr;
    }
    .tile--right .photo {
      order: 0;
    }
    .photo {
      aspect-ratio: 4 / 3;
    }
    .copy,
    .tile--left .copy,
    .tile--right .copy {
      padding: 2.5rem var(--gutter) 3.5rem;
      justify-content: flex-start;
    }
  }
</style>
